<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On
    RewriteBase /

    # 1. Blokir akses ke file sensitif dan file tersembunyi
    <FilesMatch "^\.(env|git|htaccess|htpasswd)">
        Require all denied
    </FilesMatch>

    # 2. Blokir akses langsung ke direktori sistem Laravel
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests)(/|$) - [F,L,NC]
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml|vite\.config\.js|start\.sh|router\.php|README\.md|PROJECT_CONTEXT_AND_PROGRESS\.md|akses_ftp\.md)$ - [F,L,NC]

    # 3. Blokir akses langsung ke storage logs
    RewriteRule ^storage/logs/ - [F,L,NC]

    # 4. Arahkan semua request pengunjung ke folder public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
