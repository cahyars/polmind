# ==============================================================================
# KONFIGURASI ENVIRONMENT PRODUKSI (HOSTINGER CLOUD / SHARED HOSTING)
# ==============================================================================
# Petunjuk:
# 1. Salin isi file ini ke file .env di hosting server Anda.
# 2. Sesuaikan APP_URL dengan nama domain Anda (misal: https://polmind.ac.id).
# 3. Masukkan nama Database, Username, dan Password MySQL yang telah dibuat di Hostinger.
# 4. Pastikan APP_DEBUG bernilai false saat sudah go-live untuk keamanan.
# ==============================================================================

APP_NAME="Politeknik Mitra Industri"
APP_ENV=production
APP_KEY=base64:qNPFNxYCMsBMyHKzB2Nn40WZ8vSg6kktNtEag+29w5o=
APP_DEBUG=false
APP_URL=https://polmind.ac.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ==============================================================================
# DATABASE MYSQL (HOSTINGER HPANEL)
# Catatan Hostinger: Buat database di menu "Databases" -> "MySQL Databases".
# Di Hostinger, nama DB dan Username biasanya diawali dengan prefix akun Anda
# (contoh: u633436767_polmind). Host biasanya adalah 'localhost' atau '127.0.0.1'.
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u633436767_polmind
DB_USERNAME=u633436767_polmind
DB_PASSWORD=GantiDenganPasswordDatabaseHostinger

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@polmind.ac.id"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
